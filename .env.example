VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# The public origin of the deployed site. This is the single source for the
# canonical/OG tags, robots.txt and sitemap.xml, which are all generated at
# build time. It must be the domain you actually submit for review — a
# canonical pointing at a different domain is an AdSense review problem.
VITE_SITE_URL="https://jamb-crash-ai.vercel.app"

# Credentials for scripts/run_backfill.py (explanation backfill runner).
# Keep these out of source control; rotate freely.
# BACKFILL_EMAIL=""
# BACKFILL_PASSWORD=""

# Builds generate crawlable HTML for every public page (scripts/prerender-public-pages.ts).
# That step needs the Supabase values above. PRERENDER_SKIP=1 builds without it —
# local-only, do not deploy such a build for review.
# PRERENDER_SKIP=""
