VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# The public origin of the deployed site. Used for canonical/OG tags and the
# sitemap so they always match the domain actually serving the app. Change this
# to the production domain (e.g. https://jambcrash.ai) when the custom domain is
# live, and rebuild.
VITE_SITE_URL="https://jamb-crash-ai.vercel.app"

# Credentials for scripts/run_backfill.py (explanation backfill runner).
# Keep these out of source control; rotate freely.
# BACKFILL_EMAIL=""
# BACKFILL_PASSWORD=""

# Playwright chromium executable path for scripts/prerender.mjs.
# On Windows: "C:/Users/<you>/AppData/Local/ms-playwright/chromium-1228/chrome-win64/chrome.exe"
# PW_CHROMIUM_EXE=""
